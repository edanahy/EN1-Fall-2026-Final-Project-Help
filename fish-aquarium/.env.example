# Copy this file to a new file named exactly ".env" and put your real key there.
# NEVER commit or share the .env file.
OPENAI_API_KEY=your-key-here

# Optional: set to 1 to skip OpenAI and use the simple built-in cutout (no key needed).
# (The server also does this automatically if the key above is missing.)
# MOCK_MODE=1
